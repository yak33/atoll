{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:41799/api/agent/bridge?agent=claude&name=Claude%20Code&state=idle",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:41799/api/agent/bridge?agent=claude&name=Claude%20Code&state=working",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:41799/api/agent/bridge?agent=claude&name=Claude%20Code&state=working",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:41799/api/agent/bridge?agent=claude&name=Claude%20Code&state=waiting",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:41799/api/agent/bridge?agent=claude&name=Claude%20Code&state=completed",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
